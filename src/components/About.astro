---
import Layout from "../layouts/Layout.astro";
import {
  links, profile, experience, skillGroups, softSkills, certifications, education, paths, t, type Lang,
} from "../data/site";

interface Props { lang: Lang }
const { lang } = Astro.props;
const en = lang === "en";
const p = paths(lang);

const copy = {
  title: en ? "About me | Regina Servín" : "Sobre mí | Regina Servín",
  description: en
    ? "About Regina Servín: software developer, Software Development Engineering student at Tecmilenio and FIRST Robotics coach."
    : "Conoce a Regina Servín: desarrolladora de software, estudiante de Ingeniería en Desarrollo de Software en Tecmilenio y coach de FIRST Robotics.",
  badge: en ? "About me" : "Sobre mí",
  h1: en ? ["Learning", "Leading", "Building"] : ["Aprendiendo", "Liderando", "Creando"],
  intro: en
    ? "I'm a Software Development Engineering student who already ships production software: I'm a software developer at ITESA and I'm building Nylus, a multi-tenant SaaS platform. Outside of code, I founded the first all-female community FRC team in Mexico and coordinate 17 FTC teams nationwide."
    : "Soy estudiante de Ingeniería en Desarrollo de Software y ya construyo software en producción: trabajo como desarrolladora de software en ITESA y estoy creando Nylus, una plataforma SaaS multi-tenant. Fuera del código, fundé el primer equipo comunitario 100% femenino de FRC en México y coordino 17 equipos FTC a nivel nacional.",
  projects: en ? "View projects →" : "Ver proyectos →",
  cv: en ? "Download resume" : "Descargar CV",
  quick: en ? "Quick profile" : "Perfil rápido",
  journey: en ? "My journey" : "Mi trayectoria",
  dev: en ? "Software development" : "Desarrollo de software",
  lead: en ? "Leadership & community" : "Liderazgo y comunidad",
  skills: en ? "Skills" : "Habilidades",
  soft: en ? "Strengths" : "Fortalezas",
  edu: en ? "Education" : "Educación",
  certs: en ? "Certifications" : "Certificaciones",
  ctaTitle: en ? "Let's build something great" : "Construyamos algo grande",
  ctaText: en ? "Open to freelance projects, remote roles and internships." : "Abierta a proyectos freelance, trabajo remoto y prácticas.",
  cta: en ? "Let's talk →" : "Hablemos →",
};

const quick = [
  { label: en ? "Currently" : "Actualmente", value: t(profile.current, lang) },
  { label: en ? "University" : "Universidad", value: t(profile.university, lang) },
  { label: en ? "Location" : "Ubicación", value: t(profile.location, lang) },
  { label: en ? "Languages" : "Idiomas", value: t(profile.languages, lang) },
  { label: en ? "Travel" : "Viajes", value: en ? "Not available" : "No disponible" },
  { label: en ? "Availability" : "Disponibilidad", value: t(profile.availability, lang), accent: true },
];

const groups = [
  { title: copy.dev, roles: experience.filter((r) => r.kind === "dev") },
  { title: copy.lead, roles: experience.filter((r) => r.kind !== "dev") },
];
---

<Layout lang={lang} title={copy.title} description={copy.description}>

  <section class="relative mx-auto max-w-7xl px-4 pt-6 pb-16 sm:px-6 md:pt-10 md:pb-20">
    <div class="pointer-events-none absolute right-[-120px] top-10 h-[320px] w-[320px] rounded-full bg-[#86B84C]/10 blur-3xl sm:right-0 sm:h-[420px] sm:w-[420px]"></div>

    <div class="grid gap-14 lg:grid-cols-2 lg:items-center">
      <div class="relative z-10">
        <span class="inline-flex rounded-full border border-white/10 bg-white/5 px-4 py-2 text-sm text-[#86B84C]">{copy.badge}</span>
        <h1 class="mt-6 text-4xl font-black leading-tight sm:text-5xl md:text-6xl">
          {copy.h1[0]}<br />{copy.h1[1]}<br /><span class="text-[#86B84C]">{copy.h1[2]}</span>
        </h1>
        <p class="mt-6 max-w-xl text-base leading-7 text-zinc-400 sm:text-lg sm:leading-8">{copy.intro}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={p.projects} class="w-full rounded-2xl bg-[#86B84C] px-6 py-3 text-center font-semibold text-black transition hover:scale-105 sm:w-auto">{copy.projects}</a>
          <a href={links.cv[lang]} target="_blank" class="w-full rounded-2xl border border-white/10 px-6 py-3 text-center font-semibold transition hover:border-[#86B84C] sm:w-auto">{copy.cv}</a>
        </div>
      </div>

      <div class="relative z-10">
        <div class="rounded-3xl border border-white/10 bg-white/5 p-5 backdrop-blur-xl sm:p-8">
          <h2 class="text-xl font-bold">{copy.quick}</h2>
          <div class="mt-6 space-y-5 text-zinc-300">
            {quick.map((q) => (
              <div class="flex flex-col gap-1 border-b border-white/5 pb-3 sm:flex-row sm:items-center sm:justify-between">
                <span>{q.label}</span>
                <span class:list={["font-semibold", q.accent ? "text-[#86B84C]" : "text-white"]}>{q.value}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- JOURNEY -->
  <section class="mx-auto max-w-7xl px-4 py-12 sm:px-6 md:py-16">
    <h2 class="text-3xl font-black sm:text-4xl">{copy.journey}</h2>

    {groups.map((g) => (
      <div class="mt-12">
        <h3 class="text-sm font-semibold uppercase tracking-[0.2em] text-zinc-500">{g.title}</h3>
        <div class="mt-6 space-y-5 border-l border-white/10 pl-6 sm:pl-8">
          {g.roles.map((role) => (
            <div class="relative rounded-3xl border border-white/10 bg-white/[0.02] p-5 sm:p-7 reveal">
              <span class="absolute -left-[31px] top-8 h-3 w-3 rounded-full bg-[#86B84C] shadow-[0_0_12px_#86B84C] sm:-left-[39px]"></span>
              <div class="flex flex-wrap items-baseline justify-between gap-2">
                <h4 class="text-xl font-bold sm:text-2xl">{t(role.title, lang)}</h4>
                <span class="text-sm text-zinc-500">{t(role.date, lang)}</span>
              </div>
              <p class="mt-1 font-medium text-[#86B84C]">{role.org}</p>
              <ul class="mt-4 space-y-2 text-zinc-400">
                {role.points.map((pt) => <li class="leading-7">{t(pt, lang)}</li>)}
              </ul>
            </div>
          ))}
        </div>
      </div>
    ))}
  </section>

  <!-- SKILLS -->
  <section class="mx-auto max-w-7xl px-4 py-12 sm:px-6 md:py-16 reveal">
    <h2 class="text-3xl font-black sm:text-4xl">{copy.skills}</h2>
    <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {skillGroups.map((g) => (
        <div class="rounded-3xl border border-white/10 bg-white/[0.02] p-6">
          <h3 class="font-semibold text-[#86B84C]">{t(g.label, lang)}</h3>
          <div class="mt-4 flex flex-wrap gap-2">
            {g.items.map((s) => t(s, lang)).map((s) => <span class="rounded-full border border-white/10 bg-white/[0.03] px-3 py-1.5 text-sm text-zinc-300">{s}</span>)}
          </div>
        </div>
      ))}
      <div class="rounded-3xl border border-white/10 bg-white/[0.02] p-6">
        <h3 class="font-semibold text-[#86B84C]">{copy.soft}</h3>
        <div class="mt-4 flex flex-wrap gap-2">
          {softSkills[lang].map((s) => <span class="rounded-full border border-white/10 bg-white/[0.03] px-3 py-1.5 text-sm text-zinc-300">{s}</span>)}
        </div>
      </div>
    </div>
  </section>

  <!-- EDUCATION & CERTS -->
  <section class="mx-auto max-w-7xl px-4 py-12 sm:px-6 md:py-16 reveal">
    <div class="grid gap-8 lg:grid-cols-2">
      <div>
        <h2 class="text-3xl font-black sm:text-4xl">{copy.edu}</h2>
        <div class="mt-8 rounded-3xl border border-white/10 bg-white/[0.02] p-6 sm:p-7">
          <div class="flex flex-wrap items-baseline justify-between gap-2">
            <h3 class="text-xl font-bold">{t(education.degree, lang)}</h3>
            <span class="text-sm text-zinc-500">{t(education.date, lang)}</span>
          </div>
          <p class="mt-1 font-medium text-[#86B84C]">{t(education.school, lang)}</p>
          <p class="mt-4 text-zinc-400">{t(education.note, lang)}</p>
        </div>
      </div>
      <div>
        <h2 class="text-3xl font-black sm:text-4xl">{copy.certs}</h2>
        <div class="mt-8 space-y-4">
          {certifications.map((c) => (
            <div class="flex items-start justify-between gap-4 rounded-2xl border border-white/10 bg-white/[0.02] p-5">
              <div>
                <p class="font-semibold">{t(c.name, lang)}</p>
                <p class="mt-1 text-sm text-zinc-400">{c.issuer}</p>
              </div>
              <span class="shrink-0 text-sm text-zinc-500">{t(c.date, lang)}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 md:py-20">
    <div class="rounded-[28px] border border-white/10 bg-white/[0.02] p-5 sm:p-8 md:flex md:items-center md:justify-between md:rounded-[32px] md:p-10 reveal">
      <div>
        <h2 class="text-3xl font-black sm:text-4xl">{copy.ctaTitle}</h2>
        <p class="mt-4 text-zinc-400">{copy.ctaText}</p>
      </div>
      <a href={p.contact} class="mt-6 inline-block w-full rounded-2xl bg-[#86B84C] px-7 py-4 text-center font-semibold text-black transition hover:scale-105 sm:w-auto md:mt-0">{copy.cta}</a>
    </div>
  </section>

</Layout>
